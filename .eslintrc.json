{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "globals": {
    "marked": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-var": "off",
    "prefer-const": "warn",
    "no-console": "off",
    "semi": ["warn", "always"],
    "quotes": ["warn", "double"],
    "no-debugger": "warn"
  }
}
